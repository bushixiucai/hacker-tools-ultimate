{
  "name": "hacker-toolbox-fun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:no-network": "node scripts/check-no-network.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check": "npm run check:no-network && npm run check:names && npm run check:scripts",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}