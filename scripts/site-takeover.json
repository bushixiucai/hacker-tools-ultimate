{
  "id": "site-takeover",
  "tool": "AdminGrabber Pro（入侵任意网站拿后台）",
  "disclaimer": "纯属娱乐：所有数据均为虚构，本地模拟，不发出任何网络请求。",
  "vars": {
    "target": "用户输入的网站名，默认 example.com"
  },
  "lines": [
    {
      "t": 0,
      "text": "[*] AdminGrabber Pro v4.0.4 —— 正在伪装成合法爬虫……"
    },
    {
      "t": 800,
      "text": "[*] 目标：{{target}}"
    },
    {
      "t": 1400,
      "text": "[*] DNS 解析：{{target}} → 203.0.113.{{rand:10-250}} （RFC5737 文档地址，放心）"
    },
    {
      "t": 2200,
      "text": "[+] 发现登录页：/admin/login.php?debug=true （看起来很真）"
    },
    {
      "t": 3000,
      "text": "[*] 正在枚举后台路径……",
      "progress": {
        "from": 0,
        "to": 100,
        "ms": 2800
      }
    },
    {
      "t": 6000,
      "text": "[+] /wp-admin/ …… 存在（但其实是本地假路径）"
    },
    {
      "t": 6600,
      "text": "[+] /manager/html …… 存在（Tomcat 的灵魂在召唤）"
    },
    {
      "t": 7200,
      "text": "[!] 发现『万能钥匙』：Cookie session=fake-session-{{rand:1000-9999}}"
    },
    {
      "t": 8000,
      "text": "[*] 注入友情链接……失败。改用『心理暗示』。"
    },
    {
      "t": 8800,
      "text": "[*] 正在获取超级管理员权限……",
      "progress": {
        "from": 0,
        "to": 99,
        "ms": 3200,
        "stuck_at": 99,
        "stuck_ms": 1800
      }
    },
    {
      "t": 14000,
      "text": "[!!!] 后台面板已打开：http://localhost/fake-admin/{{target}}"
    }
  ],
  "twist": {
    "popup_title": "🎉 拿下后台！",
    "popup_body": "恭喜！你成功进入了……本工具自带的演示后台。\n真实的 {{target}} 毫发无伤，它甚至不知道你存在。\n管理员密码是：你猜（提示：不是 password）。",
    "button": "我宣布自己是站长"
  },
  "easter_eggs": [
    {
      "trigger": "arg",
      "match": "google.com",
      "output": "[x] Goggle 表示：先过我的验证码再说。"
    },
    {
      "trigger": "arg",
      "match": "127.0.0.1",
      "output": "[+] 恭喜入侵本机！（你本来就有权限）"
    },
    {
      "trigger": "repeat",
      "match": "same-target-3x",
      "output": "[!] 再点我就报警给隔壁猫。"
    }
  ]
}
