{
  "id": "port-scan",
  "tool": "PortStorm 9000（端口扫描）",
  "disclaimer": "纯属娱乐：所有数据均为虚构，本地模拟，不发出任何网络请求。",
  "vars": {
    "target": "用户输入的目标主机/域名，默认 mega-corp.example"
  },
  "lines": [
    {
      "t": 0,
      "text": "[*] PortStorm 9000 v6.6.6 —— 正在加载 1337 个插件……"
    },
    {
      "t": 600,
      "text": "[*] 目标锁定：{{target}} (10.0.13.{{rand:1-254}})"
    },
    {
      "t": 1200,
      "text": "[*] 正在校准量子天线……OK"
    },
    {
      "t": 1800,
      "text": "[+] 22/tcp    open   ssh      (OpenSesame 2.0)"
    },
    {
      "t": 2300,
      "text": "[+] 80/tcp    open   http     (Apache 也是一只直升机)"
    },
    {
      "t": 2800,
      "text": "[+] 443/tcp   open   https    (证书签发者：楼下煎饼摊)"
    },
    {
      "t": 3400,
      "text": "[-] 3306/tcp  filtered mysql  (管理员正在吃午饭)"
    },
    {
      "t": 4000,
      "text": "[+] 8080/tcp  open   coffee-maker (HTTP 418 I'm a teapot)"
    },
    {
      "t": 4800,
      "text": "[!] 检测到防火墙：GreatWall-Lite™，绕过中……",
      "progress": {
        "from": 0,
        "to": 100,
        "ms": 3000
      }
    },
    {
      "t": 8000,
      "text": "[!!!] 发现超级漏洞 CVE-2077-FAKE：后台密码疑似为 'not-a-real-password'"
    },
    {
      "t": 8800,
      "text": "[*] 正在获取 root 权限……",
      "progress": {
        "from": 0,
        "to": 99,
        "ms": 2500,
        "stuck_at": 99,
        "stuck_ms": 2000
      }
    }
  ],
  "twist": {
    "popup_title": "🎉 入侵成功！",
    "popup_body": "恭喜你成功入侵了……你自己的浏览器。\n本次扫描共发现 0 个真实漏洞、1 位正在假装很忙的同事。\n{{target}} 安然无恙。",
    "button": "我是顶级黑客（不是）"
  },
  "easter_eggs": [
    {
      "trigger": "command",
      "match": "sudo make me a sandwich",
      "output": "[OK] 三明治已加入扫描队列。"
    },
    {
      "trigger": "command",
      "match": "hack nasa",
      "output": "[x] NASB 表示：今天不行，火箭在洗。"
    },
    {
      "trigger": "click",
      "match": "logo-click-5",
      "output": "[♥] 已切换到 Hello Kitty 安全模式。"
    }
  ]
}
