{
  "id": "port-scan",
  "tool": "Nmap-Automator（高精端口与服务扫描）",
  "disclaimer": "纯属娱乐：所有数据均为虚构，本地模拟，不发出任何网络请求。",
  "vars": {
    "target": "用户输入的目标主机/域名，默认 192.0.2.47"
  },
  "lines": [
    {
      "t": 0,
      "text": "[*] Starting nmap 7.94 ( https://nmap.org ) at 2026-10-18 21:50 CST"
    },
    {
      "t": 600,
      "text": "[*] Initiating SYN Stealth Scan against {{target}} [1000 ports]"
    },
    {
      "t": 1200,
      "text": "[*] Scanning 192.0.2.{{rand:10-250}} ...",
      "progress": {
        "from": 0,
        "to": 100,
        "ms": 2800
      }
    },
    {
      "t": 4200,
      "text": "PORT     STATE SERVICE       VERSION"
    },
    {
      "t": 4500,
      "text": "21/tcp   open  ftp           vsftpd 3.0.3"
    },
    {
      "t": 4800,
      "text": "22/tcp   open  ssh           OpenSSH 8.9p1 Ubuntu 3ubuntu0.4"
    },
    {
      "t": 5100,
      "text": "80/tcp   open  http          nginx 1.18.0 (Ubuntu)"
    },
    {
      "t": 5400,
      "text": "443/tcp  open  ssl/http      nginx 1.18.0 (Ubuntu)"
    },
    {
      "t": 5700,
      "text": "3306/tcp open  mysql         MySQL 8.0.35-0ubuntu0.22.04.1"
    },
    {
      "t": 6000,
      "text": "8080/tcp open  http-proxy    HAProxy 2.4.22"
    },
    {
      "t": 6600,
      "text": "[*] Initiating Service and OS Detection Engine..."
    },
    {
      "t": 7200,
      "text": "[+] Device type: general purpose | Running: Linux 5.4 - 5.15"
    },
    {
      "t": 7800,
      "text": "[+] OS details: Linux 5.4.0-42-generic (Ubuntu Linux 20.04 LTS)"
    },
    {
      "t": 8400,
      "text": "[*] Probing vulnerability signatures against detected services...",
      "progress": {
        "from": 0,
        "to": 99,
        "ms": 2400,
        "stuck_at": 99,
        "stuck_ms": 1400
      }
    },
    {
      "t": 12400,
      "text": "[+] Vulnerability verified: OpenSSH auth bypass (CVE-2077-2201)"
    },
    {
      "t": 13000,
      "text": "[!!!] Nmap done: 1 IP address (1 host up) scanned in 12.84 seconds"
    }
  ],
  "twist": {
    "popup_title": "🎉 扫描完成！",
    "popup_body": "扫描报告已生成：目标开放了 6 个虚构端口。\n其实它唯一真正敞开的端口是……你的心门❤️\n刚才全程为本地模拟，没有发出哪怕一个 ICMP 或 SYN 探测包。",
    "button": "收下心门，继续探秘"
  },
  "easter_eggs": [
    {
      "trigger": "arg",
      "match": "127.0.0.1",
      "output": "[+] 扫描本机：所有防御全开，自己黑自己成功率 100%。"
    },
    {
      "trigger": "command",
      "match": "all-ports",
      "output": "[+] 已切换至全端口 1-65535 极限扫描模式。"
    },
    {
      "trigger": "repeat",
      "match": "same-target-3x",
      "output": "[!] 对同一端口反复扫描：网卡已开始怀疑人生。"
    },
    {
      "trigger": "click",
      "match": "logo-click-5",
      "output": "[♥] 已切换到 Hello Kitty 安全模式。"
    }
  ]
}
