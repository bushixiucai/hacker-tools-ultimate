{
  "id": "satellite-trace",
  "tool": "SkyEye-404（卫星追踪）",
  "disclaimer": "纯属娱乐：所有数据均为虚构，本地模拟，不发出任何网络请求。不读取任何真实定位、通讯录或传感器数据。",
  "vars": {
    "target": "用户输入的目标名，默认 神秘目标"
  },
  "lines": [
    {
      "t": 0,
      "text": "[*] SkyEye-404 —— 呼叫低轨卫星『摸鱼一号』……"
    },
    {
      "t": 800,
      "text": "[*] 目标：{{target}}"
    },
    {
      "t": 1400,
      "text": "[+] 卫星过境窗口打开，信号强度：旺柴级别"
    },
    {
      "t": 2200,
      "text": "[*] 轨道校准中……",
      "progress": {
        "from": 0,
        "to": 100,
        "ms": 4000
      }
    },
    {
      "t": 6400,
      "text": "[+] 扫描圈收缩：伪坐标 37.{{rand:1000-9999}}°N / 122.{{rand:1000-9999}}°W（文档段附近）"
    },
    {
      "t": 7800,
      "text": "[*] Zoom ×1：锁定某块大陆轮廓（手绘风）"
    },
    {
      "t": 9800,
      "text": "[*] Zoom ×2：进入『火星市』线框地图"
    },
    {
      "t": 11800,
      "text": "[*] Zoom ×3：街区贴纸展开……有一只拖鞋的形状"
    },
    {
      "t": 13800,
      "text": "[!] 精度校准：± 半个抱枕",
      "progress": {
        "from": 0,
        "to": 99,
        "ms": 2800,
        "stuck_at": 99,
        "stuck_ms": 1200
      }
    },
    {
      "t": 18200,
      "text": "[!!!] 定位完成：火星市银河区 404 号 —— 你家沙发缝里的遥控器"
    }
  ],
  "twist": {
    "popup_title": "🛰️ 锁定成功！",
    "popup_body": "定位完成：火星市银河区 404 号 —— 你家沙发缝里的遥控器。\n精度：± 半个抱枕。\n卫星说它今天不想上班，只给了你一张猫爪印。",
    "button": "去沙发缝里找找"
  },
  "easter_eggs": [
    {
      "trigger": "command",
      "match": "trace me",
      "output": "[+] 追踪我自己：127.0.0.1 / 未知维度。你人还在这儿。"
    },
    {
      "trigger": "arg",
      "match": "moon",
      "output": "[🌙] 月球信号太吵，改推一张月亮表情包。"
    },
    {
      "trigger": "command",
      "match": "same-target-3x",
      "output": "[!] 同一目标追了 3 次，卫星翻了个白眼。"
    }
  ]
}
