{
  "id": "password-bruteforce",
  "tool": "Hydra-Pro（高并发凭据审计引擎）",
  "disclaimer": "纯属娱乐：所有数据均为虚构，本地模拟，不发出任何网络请求。",
  "vars": {
    "username": "用户输入的用户名，默认 admin",
    "target": "用户输入的目标名，默认 192.0.2.88"
  },
  "lines": [
    {
      "t": 0,
      "text": "[*] hydra v9.5 (c) 2026 - Starting concurrent credential attack"
    },
    {
      "t": 600,
      "text": "[*] Target: ssh://{{target}}:22 | Login: '{{username}}' | Threads: 16"
    },
    {
      "t": 1200,
      "text": "[*] Loaded wordlist: wordlist-top1000.txt (13,370 generated entries)"
    },
    {
      "t": 1800,
      "text": "[-] [ATTEMPT] target {{target}} - login \"{{username}}\" - pass \"admin123\" - thread 1/16"
    },
    {
      "t": 2400,
      "text": "[-] [ATTEMPT] target {{target}} - login \"{{username}}\" - pass \"P@ssw0rd2026\" - thread 4/16"
    },
    {
      "t": 3000,
      "text": "[-] [ATTEMPT] target {{target}} - login \"{{username}}\" - pass \"qwerty888\" - thread 9/16"
    },
    {
      "t": 3600,
      "text": "[*] Accelerating engine: throughput scaled to 1,840 tries/min...",
      "progress": {
        "from": 0,
        "to": 85,
        "ms": 3800
      }
    },
    {
      "t": 7600,
      "text": "[-] [ATTEMPT] target {{target}} - login \"{{username}}\" - pass \"shadow_root\" - thread 14/16"
    },
    {
      "t": 8200,
      "text": "[-] [ATTEMPT] target {{target}} - login \"{{username}}\" - pass \"dragon_99\" - thread 7/16"
    },
    {
      "t": 8800,
      "text": "[*] Hash entropy matching in progress (CVE-2077-1042)...",
      "progress": {
        "from": 85,
        "to": 99,
        "ms": 2800,
        "stuck_at": 99,
        "stuck_ms": 1800
      }
    },
    {
      "t": 13600,
      "text": "[+] Hash collision detected! Computing plaintext candidate..."
    },
    {
      "t": 14400,
      "text": "[!!!] [22][ssh] host: {{target}}   login: {{username}}   password: [VALID_CREDENTIAL_FOUND]"
    }
  ],
  "twist": {
    "popup_title": "🎉 密码已命中！",
    "popup_body": "成功捕获有效密码：iloveyou\n账号归属人：你妈。\n她刚留下一行便签：「别熬夜玩电脑了，早点睡，明天早起喝鸡汤。」\n本程序为纯本地模拟，未向任何真实主机发送登录握手。",
    "button": "好的妈，马上睡"
  },
  "easter_eggs": [
    {
      "trigger": "arg",
      "match": "root",
      "output": "[+] 用户名为 root：已自动挂载超级权限候选字典。"
    },
    {
      "trigger": "command",
      "match": "turbo",
      "output": "[+] 极速模式已开启：虚拟 CPU 满载中。"
    },
    {
      "trigger": "repeat",
      "match": "same-target-3x",
      "output": "[!] 连续爆破同一账号：账户已自动触发虚拟锁定机制。"
    }
  ]
}